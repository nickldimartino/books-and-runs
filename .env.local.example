# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). The anon key is safe
# to expose client-side — it's public by design, and access is enforced by
# the row-level security policies in supabase/migrations/0001_init.sql.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Web Push ("your turn" notifications — Settings page, app/lib/pushSubscriptions.ts).
# The public half of the VAPID keypair the `mp` Edge Function signs pushes
# with (set as its VAPID_PUBLIC_KEY/VAPID_PRIVATE_KEY secrets — never put
# the private key here or anywhere client-side). Generate a pair with
# `npx web-push generate-vapid-keys`. Optional: without it, the
# notifications toggle on Settings just reports itself unconfigured.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
