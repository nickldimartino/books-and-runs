{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": false,
    "types": ["node"]
  },
  // Just the engine — the *.test.ts files pull in vitest globals and aren't
  // part of the `npm run demo` build.
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/testHelpers.ts"]
}
